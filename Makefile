# Akatsuki task runner. TypeScript tasks delegate to pnpm/turbo, Rust tasks to cargo.
# `just` is not installed on the dev machine, so this Makefile is the entry point (BRIEF).

.DEFAULT_GOAL := help
SHELL := /bin/bash

PNPM  ?= pnpm
CARGO ?= cargo

.PHONY: help install dev build typecheck lint format test check \
        tokens shortcuts generate fixtures \
        rust-build rust-check rust-test rust-lint rust-fmt desktop sync \
        convex-up convex-down convex-reset convex-status convex-deploy convex-dev convex-codegen \
        e2e e2e-web e2e-serve

help: ## List targets
	@grep -hE '^[a-zA-Z0-9_-]+:.*?## ' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[36m%-16s\033[0m %s\n", $$1, $$2}'

# ───────────── TypeScript ─────────────
install: ## Install workspace dependencies (pnpm)
	$(PNPM) install

dev: ## Run every app's dev server (turbo)
	$(PNPM) dev

build: generate ## Build all TypeScript packages and apps
	$(PNPM) build

typecheck: ## Typecheck all TypeScript packages
	$(PNPM) typecheck

lint: ## Biome over the TypeScript tree
	$(PNPM) lint

format: ## Format and fix with Biome
	$(PNPM) format

test: ## TypeScript tests (vitest via turbo)
	$(PNPM) test

tokens: ## Regenerate design tokens (CSS, TS, crates/tokens/src/generated.rs)
	$(PNPM) tokens:build

shortcuts: ## Regenerate crates/shortcuts/src/generated.rs
	$(PNPM) shortcuts:build

generate: tokens shortcuts ## All code generators

fixtures: ## Run every shared TS/Rust fixture through both implementations (ARCHITECTURE §1.7)
	$(PNPM) --filter @akatsuki/mail-model exec vitest run
	$(PNPM) --filter @akatsuki/wire exec vitest run
	$(PNPM) --filter @akatsuki/convex exec vitest run test/fixtures.test.ts
	$(PNPM) --filter @akatsuki/ai exec vitest run
	$(PNPM) --filter @akatsuki/prompts exec vitest run
	$(CARGO) test -p akatsuki-core -p akatsuki-search -p akatsuki-ai

# ───────────── Rust ─────────────
rust-build: ## cargo build --workspace
	$(CARGO) build --workspace

rust-check: ## cargo check --workspace --all-targets
	$(CARGO) check --workspace --all-targets

rust-test: ## cargo test --workspace
	$(CARGO) test --workspace

rust-lint: ## cargo clippy (warnings are errors)
	$(CARGO) clippy --workspace --all-targets -- -D warnings

rust-fmt: ## cargo fmt --all
	$(CARGO) fmt --all

desktop: ## Run the GPUI desktop app
	$(CARGO) run -p akatsuki-desktop

sync: ## Run the sync worker locally
	$(CARGO) run -p akatsuki-sync

# ───────────── local Convex harness (docs/DEV.md) ─────────────
convex-up: ## Start the self-hosted Convex backend and write its admin key to .env.local
	node scripts/convex-dev.mjs up

convex-down: ## Stop the local backend (data kept)
	node scripts/convex-dev.mjs down

convex-reset: ## Stop the local backend and delete its data
	node scripts/convex-dev.mjs reset

convex-status: ## Show whether the local backend is up
	node scripts/convex-dev.mjs status

convex-deploy: ## Push schema + functions to the local backend (typechecked)
	$(PNPM) convex:dev:deploy

convex-dev: ## Watch convex/ and push on change to the local backend
	$(PNPM) --filter @akatsuki/convex dev

convex-codegen: ## Regenerate convex/_generated by pushing once without typecheck
	cd convex && npx convex dev --once --typecheck disable --env-file ../.env.local

# ───────────── local end-to-end (no Docker; docs/DEV.md "End-to-end") ─────────────
e2e: ## Harness + worker + fake IMAP/SMTP: sign-in, connect, sync, body, archive/undo, send (scripts/e2e-local.mjs)
	node scripts/e2e-local.mjs

e2e-web: ## make e2e, then the web app's Playwright local suites (e2e/local) against the same stack
	node scripts/e2e-local.mjs --web

e2e-serve: ## Start the worker and the fake mailbox against the harness and keep them running
	node scripts/e2e-local.mjs --serve

# ───────────── everything ─────────────
check: typecheck lint test rust-check rust-test ## Everything CI runs locally
