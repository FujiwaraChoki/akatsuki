# akatsuki-sync (apps/sync) environment: names only, never values.
# On the Hetzner host the real file is /opt/akatsuki/sync.env (mode 0600, owner root), passed to the container
# with Compose `env_file` (infra/hetzner/docker-compose.yml). Never commit it.
# Contract: docs/ARCHITECTURE.md §6.6, §6.7, §7, §9.6, §14.1, §18. Deploy steps: docs/DEPLOY.md.
#
# BIND_ADDR, API_INTERNAL_URL, PUBLIC_BASE_URL and SPOOL_DIR are fixed by the compose file and need not be
# set here.

# Convex Cloud deployment (https://<deployment>.convex.cloud / https://<deployment>.convex.site).
CONVEX_URL=
CONVEX_SITE_URL=

# Worker service identity towards Convex (ES256, §6.6). From infra/scripts/gen-service-keys.mjs
# (sync.env.part). The PEM is one line with literal \n sequences.
WORKER_ISSUER=https://sync.akatsuki.vc
WORKER_SERVICE_PRIVATE_KEY=
WORKER_SERVICE_KID=

# Provider-credential encryption keys (§14.1): "k2:<base64 32B>,k1:<base64 32B>", first is active.
TOKEN_ENC_KEYS=
# Separate 32-byte base64 keys (§14.1). `gen-service-keys.mjs --with-worker-secrets` creates all of them.
STATE_KEY=
SPOOL_KEY=
LINK_SIGNING_KEY=
IMG_PROXY_KEY=
READ_RECEIPT_KEY=

# Mailbox OAuth clients (not the login clients; those live in Convex). Redirect URIs: docs/DEPLOY.md.
GOOGLE_MAIL_CLIENT_ID=
GOOGLE_MAIL_CLIENT_SECRET=
MICROSOFT_MAIL_CLIENT_ID=
MICROSOFT_MAIL_CLIENT_SECRET=

# Gmail push (§9.6): Pub/Sub topic projects/<project>/topics/<topic>, the push subscription's OIDC audience
# (https://sync.akatsuki.vc/hooks/gmail) and the service account that signs the push JWTs.
GMAIL_PUBSUB_TOPIC=
GMAIL_PUSH_AUDIENCE=https://sync.akatsuki.vc/hooks/gmail
GMAIL_PUSH_SERVICE_ACCOUNT=
# "on" uses Gmail watch and Graph subscriptions; "off" polls only (no public webhooks needed).
SYNC_PUSH=on
SHARD_COUNT=1

# 1 lets IMAP/SMTP reach loopback and private addresses on any port. Never on the hosted worker (D-398).
MAIL_ALLOW_PRIVATE_HOSTS=

# Exact CORS origins, comma-separated.
CORS_ORIGINS=https://app.akatsuki.vc

RUST_LOG=info
