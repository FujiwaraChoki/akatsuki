# Compose interpolation values for infra/selfhost/docker-compose.yml. Copy to infra/selfhost/.env
# (gitignored) and fill in. Service secrets go in infra/selfhost/sync.env and api.env, not here.

# Public URLs served by your reverse proxy (TLS). CONVEX_SITE_URL is the Better Auth issuer.
AKATSUKI_CONVEX_URL=https://convex.example.com
AKATSUKI_CONVEX_SITE_URL=https://convex-site.example.com
AKATSUKI_SYNC_URL=https://sync.example.com

# `openssl rand -hex 32`, generated once. Losing it means generating a new admin key.
AKATSUKI_CONVEX_INSTANCE_SECRET=
AKATSUKI_CONVEX_INSTANCE_NAME=akatsuki-selfhost

# Loopback ports (change if taken).
AKATSUKI_CONVEX_PORT=3210
AKATSUKI_CONVEX_SITE_PORT=3211
AKATSUKI_CONVEX_DASHBOARD_PORT=6791
AKATSUKI_SYNC_PORT=8787
AKATSUKI_API_PORT=8788
AKATSUKI_WEB_PORT=8780

# "on" needs public Gmail Pub/Sub and Microsoft Graph webhooks reaching AKATSUKI_SYNC_URL/hooks/*.
AKATSUKI_SYNC_PUSH=off

# A build of apps/web made with your URLs (README, "Web client").
AKATSUKI_WEB_DIST=../../apps/web/dist
