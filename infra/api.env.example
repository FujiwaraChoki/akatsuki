# akatsuki-api (apps/api) environment: names only, never values.
# On the Hetzner host the real file is /opt/akatsuki/api.env (mode 0600, owner root), passed to the container
# with Compose `env_file` (infra/hetzner/docker-compose.yml). Never commit it.
# Contract: docs/ARCHITECTURE.md §6.5, §6.6, §8, §12.3, §13, §18. Deploy steps: docs/DEPLOY.md.

# Convex Cloud deployment: https://<deployment>.convex.cloud and https://<deployment>.convex.site.
# CONVEX_SITE_URL is the Better Auth JWT issuer; user JWKS are fetched from <CONVEX_SITE_URL>/api/auth/convex/jwks.
CONVEX_URL=
CONVEX_SITE_URL=

# apps/api service identity towards Convex (ES256, D-007): issuer, PKCS#8 PEM private key (P-256) and key id.
# The PEM may be given on one line with literal \n sequences. Public half: Convex env API_SERVICE_JWKS.
# Create with infra/scripts/gen-service-keys.mjs.
API_ISSUER=https://api.akatsuki.vc
API_SERVICE_PRIVATE_KEY=
API_SERVICE_KID=

# Worker tokens for POST /internal/v1/triage (aud "akatsuki-api"): the worker's public JWKS JSON and issuer.
# Leave WORKER_SERVICE_JWKS empty to disable /internal/* entirely.
WORKER_SERVICE_JWKS=
WORKER_ISSUER=https://sync.akatsuki.vc

# Managed AI (Pro): OpenRouter, always with zdr=true and data_collection=deny (§12.3). Empty disables /v1/ai/*.
OPENROUTER_API_KEY=
# Dictation (gpt-4o-transcribe). Empty disables POST /v1/ai/transcribe. Capped at 120 min/day per user by
# the daily bucket in ee.service.aiPrecheck (§13.4, D-343).
# Audio goes straight to OpenAI under its standard API data policy (no OpenRouter ZDR; D-128). If this
# organisation gets zero data retention, record it in docs/DECISIONS.md before changing any privacy copy.
OPENAI_API_KEY=

# Stripe (D-013): secret key, webhook signing secret (whsec_...) and the price lookup key.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_LOOKUP_KEY=akatsuki_pro_monthly

# Web app origin used for Checkout and portal return URLs.
SITE_URL=https://app.akatsuki.vc
# Exact CORS origins, comma-separated. Default: https://app.akatsuki.vc plus the local Vite dev server.
CORS_ORIGINS=https://app.akatsuki.vc
# "off" for self-host: billing routes and the Stripe webhook answer 404 (§13.3).
AKATSUKI_BILLING=on
# Listen address inside the container. Host nginx proxies api.akatsuki.vc to the published localhost port
# and denies /internal/ from the public internet (D-048).
BIND_ADDR=0.0.0.0:8787
