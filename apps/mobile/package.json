{
  "name": "@akatsuki/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "Akatsuki mobile app (iOS, iPadOS, Android): Expo (React Native) on Convex + Better Auth, bodies from the sync worker.",
  "license": "SEE LICENSE IN ../../LICENSE",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "export:android": "expo export --platform android --output-dir dist/android",
    "export:ios": "expo export --platform ios --output-dir dist/ios",
    "export:web": "expo export --platform web --output-dir dist/web",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@akatsuki/ai": "workspace:*",
    "@akatsuki/convex": "workspace:*",
    "@akatsuki/mail-model": "workspace:*",
