{
  "name": "@akatsuki/web",
  "version": "0.0.0",
  "private": true,
  "description": "app.akatsuki.vc: the Akatsuki web mail client. Vite + React SPA on Convex, Better Auth and the sync worker.",
  "license": "SEE LICENSE IN ../../LICENSE",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
