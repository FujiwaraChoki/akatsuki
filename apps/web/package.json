    "@akatsuki/prompts": "workspace:*",
    "@akatsuki/shortcuts": "workspace:*",
    "@akatsuki/tokens": "workspace:*",
    "@akatsuki/ui": "workspace:*",
    "@akatsuki/wire": "workspace:*",
    "@convex-dev/better-auth": "0.12.5",
    "ai": "7.0.145",
    "better-auth": "1.6.33",
    "convex": "1.47.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@akatsuki/config": "workspace:*",
    "@akatsuki/convex": "workspace:*",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
