    "@akatsuki/prompts": "workspace:*",
    "@hono/node-server": "2.1.5",
    "ai": "7.0.145",
    "convex": "1.47.0",
    "hono": "4.13.13",
    "jose": "6.2.12",
    "stripe": "23.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@akatsuki/config": "workspace:*",
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
