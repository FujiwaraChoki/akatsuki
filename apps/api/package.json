{
  "name": "@akatsuki/api",
  "version": "0.0.0",
  "private": true,
  "description": "Akatsuki API service (api.akatsuki.vc): stateless managed AI, transcription and Stripe webhook on Hono/Node.",
  "license": "SEE LICENSE IN ../../LICENSE",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/main.ts",
