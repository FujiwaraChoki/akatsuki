{
  "$description": "Akatsuki key map: the only place shortcuts are defined. TS reads it directly; Rust gets crates/shortcuts/src/generated.rs from `pnpm shortcuts:build`. Notation: a combo is modifiers plus one key joined with '+', e.g. 'cmd+shift+l'. A sequence is combos separated by one space, e.g. 'g i'. Modifiers: cmd (macOS Command), ctrl, alt, shift. Printable symbols ('#', '!', '?', '/') match the produced character, so their shift is implicit. Named keys: enter, escape, tab, space, backspace, delete, up, down, left, right. 'keys.default' applies on every platform unless 'keys.mac', 'keys.windows' or 'keys.linux' overrides it. 'gmail' optionally overrides the keys for the Gmail-style keymap (prefs.keymap = 'gmail'). 'keywords' are extra words the command palette matches (synonyms such as 'new email' for Compose).",
  "version": 1,
  "scopes": {
    "global": "Anywhere outside a text field. Shortcuts with a cmd, ctrl or alt modifier also work inside text fields.",
    "mail": "The thread list and an open thread.",
    "list": "The thread list only.",
    "thread": "An open thread only.",
    "compose": "The composer (a text field).",
    "search": "The search field (a text field).",
    "palette": "The command palette (a text field)."
  },
