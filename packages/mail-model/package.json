{
  "name": "@akatsuki/mail-model",
  "version": "0.0.0",
  "private": true,
  "description": "Akatsuki shared mail logic: label keys, applyOps, action helpers, rule matching, thread aggregates, optimistic updates and the search query grammar. Pure TypeScript, shared by Convex, web and mobile.",
  "license": "SEE LICENSE IN ../../LICENSE",
  "type": "module",
  "sideEffects": false,
  "files": [
    "src",
    "fixtures"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./query": {
      "types": "./src/query/index.ts",
      "default": "./src/query/index.ts"
    },
    "./optimistic": {
      "types": "./src/optimistic.ts",
      "default": "./src/optimistic.ts"
    },
    "./fixtures/*": "./fixtures/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@akatsuki/config": "workspace:*",
    "@types/node": "26.6.5",
    "convex": "1.47.0",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "convex": "1.47.0"
  },
  "peerDependenciesMeta": {
    "convex": {
      "optional": true
    }
  }
}
