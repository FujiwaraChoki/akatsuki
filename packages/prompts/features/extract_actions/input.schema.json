{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["transcript", "today"],
  "properties": {
    "transcript": {
      "type": "string",
      "maxLength": 120000,
      "minLength": 1
    },
    "today": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  }
}
