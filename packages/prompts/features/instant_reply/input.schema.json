{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["transcript", "userName", "voice"],
  "properties": {
    "transcript": {
      "type": "string",
      "maxLength": 120000,
      "minLength": 1
    },
    "userName": {
      "type": "string",
      "maxLength": 200
    },
    "voice": {
      "type": ["string", "null"],
      "maxLength": 2048
    }
  }
}
