{
  "$description": "Akatsuki design tokens: crimson dawn minimalism. The single source for CSS (web, landing), TypeScript (mobile) and Rust (desktop). Edit this file, then run `pnpm tokens:build`.",
  "$deprecated": {
    "$note": "First Light (docs/DECISIONS.md D-481): kept only until desktop and mobile migrate off them, then deleted. Do not use them in new code.",
    "paths": [
      "motion.orb",
      "effect.glowBlur",
      "effect.glowOpacity",
      "effect.cardBlur",
      "opacity.accent.core",
      "opacity.accent.midStrong",
      "opacity.accent.mid",
      "opacity.accent.glowStrong",
      "opacity.accent.glow",
      "opacity.accent.tint"
    ]
  },
  "color": {
    "light": {
      "accent": "#C1272D",
      "accentText": "#C1272D",
      "background": "#FFFFFF",
      "foreground": "#171717",
      "dawn": "#C1272D",
      "onAccent": "#FFFFFF"
    },
    "dark": {
      "accent": "#800000",
      "accentText": "#B77777",
      "background": "#0A0A0A",
      "foreground": "#EDEDED",
      "dawn": "#C1272D",
      "onAccent": "#FFFFFF"
    }
  },
  "opacity": {
    "foreground": {
      "text": 1,
      "secondary": 0.8,
      "tertiary": 0.7,
      "muted": 0.6,
      "borderHover": 0.4,
      "border": 0.2,
      "borderSubtle": 0.1,
      "surfaceStrong": 0.07,
      "surface": 0.04
    },
    "accent": {
      "solid": 1,
      "core": 0.7,
      "midStrong": 0.6,
      "mid": 0.5,
      "glowStrong": 0.4,
      "glow": 0.3,
      "tint": 0.15,
      "wash": 0.08
    }
  },
  "space": {
    "base": 8,
    "scale": {
      "0": 0,
      "0_5": 4,
      "1": 8,
      "1_5": 12,
      "2": 16,
      "3": 24,
      "4": 32,
      "5": 40,
      "6": 48,
      "8": 64,
      "10": 80,
      "12": 96
    }
  },
  "radius": {
    "none": 0,
    "sm": 4,
    "md": 8,
    "lg": 12,
    "xl": 16,
    "card": 24,
    "full": 9999
  },
  "font": {
    "serif": {
      "family": "Instrument Serif",
      "fallback": ["Georgia", "Times New Roman", "serif"],
      "weights": [400],
      "files": {
        "400": "InstrumentSerif-Regular.ttf",
        "400italic": "InstrumentSerif-Italic.ttf"
      }
    },
    "sans": {
      "family": "Geist",
      "fallback": [
        "system-ui",
        "-apple-system",
        "Segoe UI",
        "Roboto",
        "Helvetica Neue",
        "Arial",
        "sans-serif"
      ],
      "weights": [400, 500, 600, 700],
      "files": {
        "400": "Geist-Regular.ttf",
        "400italic": "Geist-Italic.ttf",
        "500": "Geist-Medium.ttf",
        "500italic": "Geist-MediumItalic.ttf",
        "600": "Geist-SemiBold.ttf",
        "600italic": "Geist-SemiBoldItalic.ttf",
        "700": "Geist-Bold.ttf",
        "700italic": "Geist-BoldItalic.ttf"
      }
    },
    "mono": {
      "family": "Geist Mono",
      "fallback": ["ui-monospace", "SFMono-Regular", "Menlo", "Consolas", "monospace"],
      "weights": [400, 500, 600, 700],
      "files": {
        "400": "GeistMono-Regular.ttf",
        "400italic": "GeistMono-Italic.ttf",
        "500": "GeistMono-Medium.ttf",
        "600": "GeistMono-SemiBold.ttf",
        "700": "GeistMono-Bold.ttf",
        "700italic": "GeistMono-BoldItalic.ttf"
      }
    }
  },
  "text": {
    "$note": "App styles are dense mail UI (Geist); Instrument Serif is for brand, headings, opened-thread subjects, empty states and onboarding. Brand styles are the marketing scale. size and lineHeight in px / unitless; tracking in em; sizeWide applies from 768px. First Light (D-482): mono caps (`label`) only for the reader crumb, AI provenance and chips; `section` is the sentence-case group header.",
    "app": {
      "caption": { "font": "sans", "size": 11, "lineHeight": 1.4, "tracking": 0, "weight": 400 },
      "meta": { "font": "sans", "size": 12, "lineHeight": 1.4, "tracking": 0, "weight": 400 },
      "body": { "font": "sans", "size": 13, "lineHeight": 1.5, "tracking": 0, "weight": 400 },
      "bodyStrong": { "font": "sans", "size": 13, "lineHeight": 1.5, "tracking": 0, "weight": 500 },
      "reading": { "font": "sans", "size": 15, "lineHeight": 1.6, "tracking": 0, "weight": 400 },
      "code": { "font": "mono", "size": 12, "lineHeight": 1.5, "tracking": 0, "weight": 400 },
      "label": {
        "font": "mono",
        "size": 11,
        "lineHeight": 1.4,
        "tracking": 0.12,
        "weight": 500,
        "uppercase": true
      },
      "section": { "font": "sans", "size": 12, "lineHeight": 1.4, "tracking": 0, "weight": 500 },
      "subject": {
        "font": "serif",
        "size": 24,
        "sizeWide": 30,
        "lineHeight": 1.15,
        "tracking": -0.01,
        "weight": 400
      },
      "heading": { "font": "serif", "size": 28, "lineHeight": 1.3, "tracking": 0, "weight": 400 },
      "empty": { "font": "serif", "size": 32, "lineHeight": 1.2, "tracking": -0.01, "weight": 400 }
    },
    "brand": {
      "display": {
        "font": "serif",
        "size": 80,
        "sizeWide": 120,
        "lineHeight": 1,
        "tracking": -0.02,
        "weight": 400
      },
      "title": {
        "font": "serif",
        "size": 48,
        "sizeWide": 64,
        "lineHeight": 1.4,
        "tracking": 0,
        "weight": 400
      },
      "heading": { "font": "serif", "size": 28, "lineHeight": 1.3, "tracking": 0, "weight": 400 },
      "subhead": { "font": "serif", "size": 20, "lineHeight": 1.4, "tracking": 0, "weight": 400 },
      "body": { "font": "serif", "size": 16, "lineHeight": 1.75, "tracking": 0, "weight": 400 },
      "small": { "font": "serif", "size": 14, "lineHeight": 1.5, "tracking": 0, "weight": 400 },
      "label": {
        "font": "serif",
        "size": 14,
        "lineHeight": 1.4,
        "tracking": 0.3,
        "weight": 400,
        "uppercase": true
      }
    }
  },
  "motion": {
    "duration": {
      "instant": 80,
      "quick": 140,
      "fast": 200,
      "normal": 500,
      "slow": 800,
      "stagger": 80
    },
    "easing": {
      "out": [0, 0, 0.2, 1],
      "inOut": [0.4, 0, 0.2, 1],
      "cine": [0.16, 1, 0.3, 1]
    },
    "orb": {
      "blur": 80,
      "opacity": 0.3,
      "floatSeconds": [25, 30, 20],
      "morphSeconds": [18, 22, 15],
      "pulseSeconds": 8
    }
  },
  "layout": {
    "contentMaxWidth": 768,
    "wideMaxWidth": 1024,
    "pagePadding": 24,
    "rowHeightCompact": 32,
    "rowHeightComfortable": 44,
    "rowHeightTouch": 64,
    "sidebarWidth": 216,
    "toolbarHeight": 44,
    "statusBarHeight": 28
  },
  "effect": {
    "glowBlur": 30,
    "glowOpacity": 0.4,
    "cardBlur": 20,
    "popOpacityLight": 0.14,
    "popOpacityDark": 0.9
  }
}
