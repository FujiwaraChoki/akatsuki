{
  "name": "@akatsuki/wire",
  "version": "0.0.0",
  "private": true,
  "description": "Akatsuki wire contract: sync worker and apps/api types, the error-code registry, the AI stream protocol (AASP), access tokens, typed HTTP clients and re-exported Convex validators.",
  "license": "SEE LICENSE IN ../../LICENSE",
  "type": "module",
  "sideEffects": false,
  "files": [
    "src",
    "fixtures"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./aasp": {
      "types": "./src/aasp.ts",
      "default": "./src/aasp.ts"
    },
    "./errors": {
      "types": "./src/errors.ts",
      "default": "./src/errors.ts"
    },
    "./convex": {
      "types": "./src/convex.ts",
      "default": "./src/convex.ts"
    },
    "./fixtures/*": "./fixtures/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.convex.json",
    "test": "vitest run"
  },
  "dependencies": {
    "convex": "1.47.0"
  },
  "devDependencies": {
    "@akatsuki/config": "workspace:*",
    "@akatsuki/convex": "workspace:*",
    "@types/node": "26.6.5",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
