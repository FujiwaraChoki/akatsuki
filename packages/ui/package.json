{
  "name": "@akatsuki/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Akatsuki shared React primitives for web and landing (crimson dawn minimalism): buttons, keyboard hints, tooltips, menus, dialogs, toasts, the command palette, list rows, avatars, orbs and error copy. Styled only with @akatsuki/tokens CSS variables.",
  "license": "SEE LICENSE IN ../../LICENSE",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "src"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./errors": {
      "types": "./src/errors.ts",
      "default": "./src/errors.ts"
    },
    "./copy": {
      "types": "./src/copy.ts",
      "default": "./src/copy.ts"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@akatsuki/mail-model": "workspace:*",
    "@akatsuki/shortcuts": "workspace:*",
    "@akatsuki/tokens": "workspace:*",
    "@akatsuki/wire": "workspace:*",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@radix-ui/react-visually-hidden": "1.2.13"
  },
  "devDependencies": {
    "@akatsuki/config": "workspace:*",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
