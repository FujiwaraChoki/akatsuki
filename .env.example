# Akatsuki environment variables: names only, never values.
#
# Real values live in gitignored files: .env.local (local dev; the self-hosted Convex harness appends
# to it), .env.credentials (keys created during setup), the Convex deployment env
# (`npx convex env set`), the Hetzner env files for apps/sync and apps/api (mode 0600), Vercel
# project env, and CI secrets. See docs/DEV.md and docs/CREDENTIALS.md.
# Contract reference: docs/ARCHITECTURE.md §18 (environment variable names).

# ───────────── Convex: choosing a deployment (CLI) ─────────────
# Convex Cloud (production). Not configured yet; the owner creates the project and the deploy key.
CONVEX_DEPLOYMENT=
# CI only: never on a running server (D-007, D-017).
CONVEX_DEPLOY_KEY=
# Local self-hosted backend (dev/test harness). Written by `make convex-up`.
CONVEX_SELF_HOSTED_URL=
CONVEX_SELF_HOSTED_ADMIN_KEY=

# ───────────── Convex deployment env (set with `npx convex env set`, never in files on servers) ─────────────
# Web app origin, e.g. https://app.akatsuki.vc. Better Auth crossDomain redirects here.
SITE_URL=
# 32+ random bytes, base64. Signs Better Auth sessions.
BETTER_AUTH_SECRET=
# Extra trusted origins for local dev, comma-separated (e.g. http://localhost:5173).
DEV_ORIGINS=
# Social login only (openid email profile). Separate from the mailbox OAuth clients below.
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
MICROSOFT_LOGIN_CLIENT_ID=
MICROSOFT_LOGIN_CLIENT_SECRET=
GITHUB_LOGIN_CLIENT_ID=
GITHUB_LOGIN_CLIENT_SECRET=
# Service identities (ES256, D-007): issuers and the public JWKS JSON of each service.
WORKER_ISSUER=
API_ISSUER=
WORKER_SERVICE_JWKS=
API_SERVICE_JWKS=
# Transactional email through SES v2, IAM user akatsuki-ses-sender (§14.6).
AWS_SES_REGION=
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
# Default: Akatsuki <no-reply@akatsuki.vc>
SES_FROM_ADDRESS=
# ses (default) | console | none. console is refused unless CONVEX_SITE_URL is loopback (the local harness,
# which logs the address, link and code) or AKATSUKI_DEV_HARNESS=1 (logs the email redacted). §14.6, D-350.
EMAIL_TRANSPORT=
# "1" on a non-local dev deployment to allow EMAIL_TRANSPORT=console with redacted logs. Never in production.
AKATSUKI_DEV_HARNESS=
# "off" for self-host: every user is entitled, no Stripe (§13.3).
AKATSUKI_BILLING=
# "on" to allow the managed AI provider on a self-hosted install.
AKATSUKI_MANAGED_AI=
# Also set SHARD_COUNT (below, with the worker) here, to the same value: Convex fixes each account's shard at
# insert and its watchdog walks every shard (D-404). Optional: IPs/CIDRs of the proxies in front of Convex
# HTTP actions, comma-separated, so Better Auth can resolve a multi-hop x-forwarded-for (D-401).
AUTH_TRUSTED_PROXIES=

# ───────────── Convex URLs (read by the worker, apps/api and scripts) ─────────────
# https://<deployment>.convex.cloud and https://<deployment>.convex.site (the JWT issuer).
CONVEX_URL=
CONVEX_SITE_URL=

# ───────────── Clients (public, bundled into the apps) ─────────────
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=
# Sync worker and apps/api base URLs, e.g. https://sync.akatsuki.vc and https://api.akatsuki.vc
VITE_SYNC_URL=
VITE_API_URL=
# Social sign-in buttons the web app shows, comma-separated: google,microsoft (D-261). Match the deployment's
# GOOGLE_LOGIN_CLIENT_ID / MICROSOFT_LOGIN_CLIENT_ID. Empty: email code and magic link only.
VITE_LOGIN_PROVIDERS=
EXPO_PUBLIC_CONVEX_URL=
EXPO_PUBLIC_CONVEX_SITE_URL=
EXPO_PUBLIC_SYNC_URL=
EXPO_PUBLIC_API_URL=
# Social sign-in buttons on mobile, like VITE_LOGIN_PROVIDERS: comma-separated google,microsoft (D-332).
EXPO_PUBLIC_LOGIN_PROVIDERS=
# Mobile builds only (apps/mobile/app.config.ts, read by the Expo CLI and EAS; not secrets): the EAS project id
# from `eas init` (needed for push tokens) and the Expo account that owns the project (D-338).
EAS_PROJECT_ID=
EXPO_OWNER=
# Landing site: the web app's origin it names (default https://app.akatsuki.vc).
NEXT_PUBLIC_APP_URL=
# Development and tests: "mock" selects the in-memory backend in a mock-mode web build (D-404).
VITE_AKATSUKI_BACKEND=

# ───────────── Desktop app (apps/desktop; read at start-up, none of these is a secret) ─────────────
# The desktop also reads desktop.json in its config directory; the environment wins (D-314).
AKATSUKI_CONVEX_URL=
AKATSUKI_CONVEX_SITE_URL=
AKATSUKI_SYNC_URL=
AKATSUKI_API_URL=
AKATSUKI_DATA_DIR=
# Development and smoke tests: 1 opens the demo mailbox; quit after N ms; run command ids; prompt checkout.
AKATSUKI_DEMO=
AKATSUKI_EXIT_AFTER_MS=
AKATSUKI_SCRIPT=
AKATSUKI_PROMPTS_DIR=
# crates/ai development builds: the checkout whose packages/prompts to read.
AKATSUKI_REPO_ROOT=
# Ignored live tests against the local Convex harness only (docs/DEV-RUST.md).
AKATSUKI_LIVE_SITE=
AKATSUKI_LIVE_CONVEX=
AKATSUKI_LIVE_OTP_LOG=

# ───────────── Sync worker (apps/sync, Hetzner) ─────────────
WORKER_SERVICE_PRIVATE_KEY=
WORKER_SERVICE_KID=
# "k2:<base64 32B>,k1:<base64 32B>", first key active (§14.1). Encrypts provider tokens at rest.
TOKEN_ENC_KEYS=
STATE_KEY=
SPOOL_KEY=
LINK_SIGNING_KEY=
IMG_PROXY_KEY=
READ_RECEIPT_KEY=
# Optional: encrypted upload spool directory (default /var/lib/akatsuki/spool).
SPOOL_DIR=
# Optional: PEM file of extra trusted roots for IMAP/SMTP servers with a private CA (D-381).
MAIL_CA_FILE=
# Optional: 1 lets IMAP/SMTP reach loopback and private addresses on any port (local harness, LAN mail
# server when self-hosting). Leave unset on the hosted worker (D-398).
MAIL_ALLOW_PRIVATE_HOSTS=
# Mailbox OAuth clients (held only by the worker).
GOOGLE_MAIL_CLIENT_ID=
GOOGLE_MAIL_CLIENT_SECRET=
MICROSOFT_MAIL_CLIENT_ID=
MICROSOFT_MAIL_CLIENT_SECRET=
# Gmail push: projects/<project>/topics/<topic>, the push OIDC audience and service account.
GMAIL_PUBSUB_TOPIC=
GMAIL_PUSH_AUDIENCE=
GMAIL_PUSH_SERVICE_ACCOUNT=
# on | off (off = polling only, §9.6)
SYNC_PUSH=
# Number of worker shards (1 in v1). The Convex deployment env needs the same value (D-404).
SHARD_COUNT=
# Exact origins, comma-separated (also used by apps/api).
CORS_ORIGINS=
# Public base URL of the worker, e.g. https://sync.akatsuki.vc
PUBLIC_BASE_URL=
# apps/api on the Docker network, for POST /internal/v1/triage.
API_INTERNAL_URL=
# host:port to listen on (also used by apps/api).
BIND_ADDR=

# ───────────── apps/api (Hono, Hetzner) ─────────────
# apps/api also reads CONVEX_URL, CONVEX_SITE_URL, API_ISSUER, WORKER_ISSUER, WORKER_SERVICE_JWKS, SITE_URL,
# CORS_ORIGINS, AKATSUKI_BILLING and BIND_ADDR from above; its full list is infra/api.env.example (§18).
API_SERVICE_PRIVATE_KEY=
API_SERVICE_KID=
# Managed AI (Pro) and transcription. Never on clients; never logged.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price lookup key (akatsuki_pro_monthly); apps/api resolves the price id from it.
STRIPE_PRICE_LOOKUP_KEY=

# ───────────── Ops only (owner tooling; never set on Convex, the worker, apps/api or a client) ─────────────
# Cloudflare DNS token scoped to akatsuki.vc (DNS edit, zone read).
CLOUDFLARE_API_TOKEN=
# Kept next to STRIPE_SECRET_KEY. No component reads it: Checkout sessions are created server-side (§13.1).
STRIPE_PUBLISHABLE_KEY=
